{
	"name": "thuexemayhanoi/nguyen-ha-editorial",
	"description": "Nguyen Ha Editorial: premium SEO/AEO/GEO editorial WordPress theme and companion plugin (development tooling).",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"private": true,
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "*",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:theme": "phpunit --testsuite theme",
		"test:plugin": "phpunit --testsuite plugin"
	}
}
