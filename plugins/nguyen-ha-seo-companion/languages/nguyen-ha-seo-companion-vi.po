#. Plugin Name of the plugin
#: nguyen-ha-seo-companion.php
msgid "Nguyen Ha SEO Companion"
msgstr "Nguyen Ha SEO Companion"

#. Plugin URI of the plugin
#: nguyen-ha-seo-companion.php
msgid "https://github.com/thuexemayhanoi/wordpress-theme"
msgstr "https://github.com/thuexemayhanoi/wordpress-theme"

#. Description of the plugin
#: nguyen-ha-seo-companion.php
msgid "Companion plugin for the Nguyen Ha Editorial theme. Keeps SEO and editorial data independent of the theme: topic clusters, answer-first summary, FAQ and sources, verified business profile, schema extensions, internal search index and cache purging."
msgstr "Plugin đồng hành cho giao diện Nguyen Ha Editorial. Giữ dữ liệu SEO và biên tập độc lập với giao diện: cụm chủ đề, phần trả lời nhanh, câu hỏi thường gặp và nguồn tham khảo, hồ sơ doanh nghiệp đã xác minh, dữ liệu có cấu trúc (schema), chỉ mục tìm kiếm nội bộ và xóa bộ nhớ đệm trang."

#. Author of the plugin
#: nguyen-ha-seo-companion.php
msgid "Nguyen Ha Web Team"
msgstr "Nguyen Ha Web Team"

#. Author URI of the plugin
#: nguyen-ha-seo-companion.php
msgid "https://github.com/thuexemayhanoi"
msgstr "https://github.com/thuexemayhanoi"

