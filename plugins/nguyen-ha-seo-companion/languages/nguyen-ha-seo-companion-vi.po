msgstr "Các tài liệu hỗ trợ cho bài viết. Chỉ giữ lại liên kết http và https."

#: includes/admin/class-nh-seo-meta-box.php:165
msgid "Add source"
msgstr "Thêm nguồn"

#. translators: %d: position of the source in the list.
#: includes/admin/class-nh-seo-meta-box.php:167
#, php-format
