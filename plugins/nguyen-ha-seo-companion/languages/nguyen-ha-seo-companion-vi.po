#: includes/admin/class-nh-seo-meta-box.php:292
msgid "Internal linking"
msgstr "Liên kết nội bộ"

#: includes/admin/class-nh-seo-meta-box.php:310
#: includes/admin/class-nh-seo-meta-box.php:319
msgid "Primary Topic Cluster"
msgstr "Cụm chủ đề chính"

#: includes/admin/class-nh-seo-meta-box.php:312
msgid "Automatic (the cluster with the lowest ID)"
msgstr "Tự động (cụm có ID nhỏ nhất)"

#: includes/admin/class-nh-seo-meta-box.php:317
msgid "Decides the silo used for related and adjacent articles. Only clusters assigned to this post are listed."
msgstr "Quyết định nhóm silo dùng cho bài liên quan và bài kế tiếp. Chỉ liệt kê các cụm đã gán cho bài viết này."

#: includes/admin/class-nh-seo-meta-box.php:320
msgid "Assign Topic Clusters to this post and save it, then come back to choose the primary one."
msgstr "Hãy gán Cụm chủ đề cho bài viết này và lưu lại, sau đó quay lại để chọn cụm chính."

#. translators: %s: cluster alias written by an automated workflow.
#: includes/admin/class-nh-seo-meta-box.php:329
#, php-format
msgid "The cluster alias \"%s\" sent by a workflow does not match any Topic Cluster yet. Create the cluster or enable automatic creation in the plugin settings."
msgstr "Định danh cụm \"%s\" do quy trình đăng bài tự động gửi đến chưa khớp với Cụm chủ đề nào. Hãy tạo cụm đó hoặc bật tính năng tự động tạo trong phần cài đặt của plugin."

#: includes/admin/class-nh-seo-meta-box.php:337
#: includes/admin/class-nh-seo-term-fields.php:56
#: includes/admin/class-nh-seo-term-fields.php:80
msgid "Pillar page ID"
msgstr "ID trang trụ cột"

#: includes/admin/class-nh-seo-meta-box.php:354
msgid "The published post or page that is the Pillar of this content. It overrides the Pillar of the topic. Find the ID in the address bar when you edit that page (post=123). Leave empty to use the Pillar of the topic."
msgstr "Bài viết hoặc trang đã xuất bản đóng vai trò trụ cột của nội dung này. Giá trị này được ưu tiên hơn trang trụ cột của chủ đề. ID nằm trên thanh địa chỉ khi bạn chỉnh sửa trang đó (post=123). Để trống để dùng trang trụ cột của chủ đề."

#: includes/admin/class-nh-seo-meta-box.php:359
msgid "Topic listed by this Pillar or Hub page"
msgstr "Chủ đề được liệt kê bởi trang trụ cột hoặc trang Hub này"

#: includes/admin/class-nh-seo-meta-box.php:361
msgid "Choose the category or Topic Cluster whose articles this page lists. Leave it empty for ordinary pages."
msgstr "Chọn chuyên mục hoặc Cụm chủ đề mà trang này liệt kê bài viết. Để trống với các trang thông thường."

#: includes/admin/class-nh-seo-meta-box.php:377
msgid "Categories"
msgstr "Chuyên mục"

#: includes/admin/class-nh-seo-meta-box.php:378
#: includes/admin/class-nh-seo-settings-page.php:352
#: includes/admin/class-nh-seo-settings-page.php:771
#: includes/data/class-nh-seo-data-model.php:63
msgid "Topic Clusters"
msgstr "Cụm chủ đề"

#: includes/admin/class-nh-seo-meta-box.php:383
#: includes/admin/class-nh-seo-settings-page.php:765
msgid "None"
msgstr "Không có"

#: includes/admin/class-nh-seo-meta-box.php:430
msgid "Search and local"
msgstr "Tìm kiếm và địa phương"

#: includes/admin/class-nh-seo-meta-box.php:433
msgid "Search keywords"
msgstr "Từ khóa tìm kiếm"

#: includes/admin/class-nh-seo-meta-box.php:435
msgid "Extra words, separated by commas, that should find this content in the site search. Visitors never see them."
msgstr "Các từ bổ sung, cách nhau bằng dấu phẩy, giúp tìm thấy nội dung này trong tìm kiếm của website. Khách truy cập không nhìn thấy chúng."

#: includes/admin/class-nh-seo-meta-box.php:442
msgid "This page has verified local-business context"
msgstr "Trang này có thông tin doanh nghiệp địa phương đã được xác minh"

#: includes/admin/class-nh-seo-meta-box.php:445
msgid "Tick it only for pages about the real business, such as the contact or location page. It enables LocalBusiness structured data when the business profile is complete."
msgstr "Chỉ chọn cho các trang nói về chính doanh nghiệp thật, ví dụ trang liên hệ hoặc trang địa điểm. Tùy chọn này bật dữ liệu có cấu trúc LocalBusiness khi hồ sơ doanh nghiệp đã đầy đủ."

#: includes/admin/class-nh-seo-meta-box.php:448
msgid "The business profile is not complete yet, so nothing is output."
msgstr "Hồ sơ doanh nghiệp chưa đầy đủ nên chưa có dữ liệu nào được xuất ra."

#: includes/admin/class-nh-seo-meta-box.php:450
msgid "Complete the business profile"
msgstr "Hoàn thiện hồ sơ doanh nghiệp"

#. translators: %s: the value typed in the Pillar page ID field.
#: includes/admin/class-nh-seo-meta-box.php:552
#, php-format
msgid "The Pillar page ID \"%s\" was ignored. It must be the ID of another published, public post or page."
msgstr "ID trang trụ cột \"%s\" đã bị bỏ qua. Đó phải là ID của một bài viết hoặc trang công khai khác đã xuất bản."

#: includes/admin/class-nh-seo-settings-page.php:74
msgid "Settings"
msgstr "Cài đặt"

#: includes/admin/class-nh-seo-settings-page.php:169
msgid "Identity"
msgstr "Thông tin nhận diện"

#: includes/admin/class-nh-seo-settings-page.php:173
msgid "Business name"
msgstr "Tên doanh nghiệp"

#: includes/admin/class-nh-seo-settings-page.php:176
msgid "The name customers know. Used in structured data and the contact block of the theme."
msgstr "Tên mà khách hàng biết đến. Dùng trong dữ liệu có cấu trúc và khối liên hệ của giao diện."

#: includes/admin/class-nh-seo-settings-page.php:180
msgid "Legal name"
msgstr "Tên pháp lý"

#: includes/admin/class-nh-seo-settings-page.php:183
msgid "Optional. The registered company name, if it differs from the business name."
msgstr "Không bắt buộc. Tên công ty đã đăng ký, nếu khác với tên doanh nghiệp."

#: includes/admin/class-nh-seo-settings-page.php:187
msgid "Business type"
msgstr "Loại hình doanh nghiệp"

#: includes/admin/class-nh-seo-settings-page.php:190
msgid "The most specific schema.org type that is true for the business. When unsure, keep LocalBusiness."
msgstr "Loại schema.org cụ thể nhất đúng với doanh nghiệp. Nếu chưa chắc chắn, hãy giữ LocalBusiness."

#: includes/admin/class-nh-seo-settings-page.php:194
msgid "Website address"
msgstr "Địa chỉ website"

#: includes/admin/class-nh-seo-settings-page.php:196
msgid "Optional. The official website of the business, starting with https://."
msgstr "Không bắt buộc. Website chính thức của doanh nghiệp, bắt đầu bằng https://."

#: includes/admin/class-nh-seo-settings-page.php:200
msgid "Logo"
msgstr "Logo"

#: includes/admin/class-nh-seo-settings-page.php:202
msgid "Optional. An image from the media library. Nothing is output without a logo."
msgstr "Không bắt buộc. Một ảnh trong thư viện media. Không có logo thì không có dữ liệu logo nào được xuất ra."

#: includes/admin/class-nh-seo-settings-page.php:207
msgid "Contact"
msgstr "Liên hệ"

#: includes/admin/class-nh-seo-settings-page.php:211
msgid "Phone number"
msgstr "Số điện thoại"

#: includes/admin/class-nh-seo-settings-page.php:214
msgid "A number that customers can really call, with the country code."
msgstr "Số điện thoại khách hàng có thể gọi thật sự, kèm mã quốc gia."

#: includes/admin/class-nh-seo-settings-page.php:218
msgid "Email address"
msgstr "Địa chỉ email"

#: includes/admin/class-nh-seo-settings-page.php:220
msgid "Optional. A public contact address."
msgstr "Không bắt buộc. Địa chỉ liên hệ công khai."

#: includes/admin/class-nh-seo-settings-page.php:225
msgid "Address"
msgstr "Địa chỉ"

#: includes/admin/class-nh-seo-settings-page.php:229
msgid "Street address"
msgstr "Số nhà, đường"

#: includes/admin/class-nh-seo-settings-page.php:235
msgid "City"
msgstr "Thành phố"

#: includes/admin/class-nh-seo-settings-page.php:241
msgid "State or region"
msgstr "Tỉnh hoặc vùng"

#: includes/admin/class-nh-seo-settings-page.php:247
msgid "Postal code"
msgstr "Mã bưu chính"

#: includes/admin/class-nh-seo-settings-page.php:253
msgid "Country code"
msgstr "Mã quốc gia"

#: includes/admin/class-nh-seo-settings-page.php:256
msgid "Two letters (ISO 3166-1), for example VN."
msgstr "Hai chữ cái (ISO 3166-1), ví dụ VN."

#: includes/admin/class-nh-seo-settings-page.php:260
msgid "Latitude"
msgstr "Vĩ độ"

#: includes/admin/class-nh-seo-settings-page.php:263
msgid "Optional. Decimal degrees between -90 and 90, copied from a map service."
msgstr "Không bắt buộc. Tọa độ dạng số thập phân từ -90 đến 90, sao chép từ một dịch vụ bản đồ."

#: includes/admin/class-nh-seo-settings-page.php:267
msgid "Longitude"
msgstr "Kinh độ"

#: includes/admin/class-nh-seo-settings-page.php:270
msgid "Optional. Decimal degrees between -180 and 180."
msgstr "Không bắt buộc. Tọa độ dạng số thập phân từ -180 đến 180."

#: includes/admin/class-nh-seo-settings-page.php:275
msgid "Opening hours and links"
msgstr "Giờ mở cửa và liên kết"

#: includes/admin/class-nh-seo-settings-page.php:279
msgid "Opening hours"
msgstr "Giờ mở cửa"

#: includes/admin/class-nh-seo-settings-page.php:282
msgid "One rule per line: days, a space, then the opening and closing time, for example Mo-Su 09:00-21:00 or Sa,Su 10:00-12:30. Days are Mo Tu We Th Fr Sa Su. Lines in another format are ignored. Only enter hours that are accurate."
msgstr "Mỗi dòng một quy tắc: các ngày, một dấu cách, rồi giờ mở và đóng cửa, ví dụ Mo-Su 09:00-21:00 hoặc Sa,Su 10:00-12:30. Các ngày là Mo Tu We Th Fr Sa Su. Dòng có định dạng khác sẽ bị bỏ qua. Chỉ nhập giờ chính xác."

#: includes/admin/class-nh-seo-settings-page.php:286
msgid "Price range"
msgstr "Mức giá"

#: includes/admin/class-nh-seo-settings-page.php:289
msgid "Optional free text. Leave it empty when unsure."
msgstr "Không bắt buộc, nhập tự do. Để trống nếu chưa chắc chắn."

#: includes/admin/class-nh-seo-settings-page.php:293
msgid "Map link"
msgstr "Liên kết bản đồ"

#: includes/admin/class-nh-seo-settings-page.php:295
msgid "Optional. A link to the business on a map service."
msgstr "Không bắt buộc. Liên kết đến doanh nghiệp trên một dịch vụ bản đồ."

#: includes/admin/class-nh-seo-settings-page.php:299
msgid "Social profiles"
msgstr "Trang mạng xã hội"

#: includes/admin/class-nh-seo-settings-page.php:302
msgid "One profile address per line (http or https). Used to tell search engines which profiles belong to the business."
msgstr "Mỗi dòng một địa chỉ trang (http hoặc https). Dùng để cho công cụ tìm kiếm biết những trang nào thuộc về doanh nghiệp."

#: includes/admin/class-nh-seo-settings-page.php:317
msgid "Structured data"
msgstr "Dữ liệu có cấu trúc"

#: includes/admin/class-nh-seo-settings-page.php:321
msgid "Structured data mode"
msgstr "Chế độ dữ liệu có cấu trúc"

#: includes/admin/class-nh-seo-settings-page.php:324
msgid "Automatic (recommended)"
msgstr "Tự động (khuyên dùng)"

#: includes/admin/class-nh-seo-settings-page.php:325
#: includes/admin/class-nh-seo-settings-page.php:723
msgid "Extras only: FAQ and local business next to another SEO plugin"
