#, php-format
msgid "Move source %d down"
msgstr "Chuyển nguồn %d xuống"

#. translators: %d: position of the source in the list.
#: includes/admin/class-nh-seo-meta-box.php:171
#, php-format
msgid "Remove source %d"
msgstr "Xóa nguồn %d"

