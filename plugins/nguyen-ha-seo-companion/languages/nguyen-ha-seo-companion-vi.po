msgstr "Tối đa %s ý chính."

#. translators: %s: maximum number of characters per takeaway.
#: includes/admin/class-nh-seo-meta-box.php:118
#, php-format
msgid "One takeaway per line, up to %s characters each. Only add them when the article really has key points."
msgstr "Mỗi dòng một ý, tối đa %s ký tự mỗi ý. Chỉ thêm khi bài viết thật sự có các ý chính."

#: includes/admin/class-nh-seo-meta-box.php:124
msgid "Content updated"
msgstr "Ngày cập nhật nội dung"

#: includes/admin/class-nh-seo-meta-box.php:126
msgid "The date the content was really revised, not the date of a small edit. Leave it empty when unsure. Future dates are ignored."
msgstr "Ngày nội dung thực sự được rà soát hoặc sửa đổi, không phải ngày chỉnh sửa nhỏ. Để trống nếu chưa chắc chắn. Ngày trong tương lai sẽ bị bỏ qua."

#: includes/admin/class-nh-seo-meta-box.php:134
#: includes/render/class-nh-seo-renderer.php:119
msgid "Frequently asked questions"
msgstr "Câu hỏi thường gặp"

#: includes/admin/class-nh-seo-meta-box.php:135
msgid "Questions people really ask about this topic. Answers may use basic HTML: links, paragraphs, bold, italic, lists and code."
msgstr "Những câu hỏi mọi người thực sự hay hỏi về chủ đề này. Câu trả lời có thể dùng HTML cơ bản: liên kết, đoạn văn, chữ đậm, chữ nghiêng, danh sách và mã."

