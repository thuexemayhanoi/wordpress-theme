# Development files at the top of the repository are not meant to be downloaded when a deployment
# copies the whole repository into the theme folder (docs/DEPLOYMENT.md). The installable zip does not
# contain these files or this one.
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|phpcs\.xml\.dist|phpunit\.xml\.dist|\.gitattributes|\.gitignore)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
