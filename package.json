{
  "name": "nguyen-ha-editorial",
  "version": "2.0.2",
  "private": true,
  "description": "Build and QA tooling for the Nguyen Ha Editorial WordPress theme (never loaded by WordPress itself).",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "node tools/build-assets.mjs",
    "build:check": "node tools/build-assets.mjs --check",
    "lint:js": "node tools/build-assets.mjs --check",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2"
  }
}
